# Dependencias y compilados
node_modules/
dist/
build/
npm-debug.log
yarn-error.log

# Claves
.env
.env.local
.dev.vars*
!.dev.vars.example
!.env.example

# Editor y sistema
.claude/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Todo lo que no se publica vive en _local/: demos en curso, material de
# diseño, negocio y archivo. Si algo no debe publicarse, se mueve ahí y no
# hace falta tocar este fichero.
_local/

# captacion/ es un repositorio aparte, con su propio historial.
captacion/

# La versión en euskera se genera en cada despliegue con
# herramientas/sitio/generar-euskera.mjs desde las páginas en castellano.
# No editar a mano ni commitear.
web/eu/

# Caché de wrangler
.wrangler

*.bat

# Datos de clientes: este repositorio es PÚBLICO. Nada de clientes (CIF, correos,
# teléfonos, código de sus webs) ni los scripts que generan sus demos con sus
# datos reales. Siguen en el disco; solo no se suben.
clientes/
herramientas/demos/demo-*.mjs
herramientas/demos/fotos-biciprecision.mjs

# Capturas de trabajo de las muestras (se usan para generar las tarjetas de
# web/assets/; no se publican).
web/demos/muestras/*/_capturas/
