        "emailFormat": "html",
        "html": "=<p>Hola {{ $json.cliente }}:</p><p>La factura <strong>{{ $json.numero }}</strong> de {{ $json.importe }} € lleva {{ $json.dias }} días vencida. Antes de dar otro paso preferimos hablarlo: contestá a este correo o llamanos.</p>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "",
          "name": "Gmail SMTP (gratis)"
        }
      },
      "id": "oi-0092",
      "position": [
        500,
        420
