{
  "name": "OI · Recordatorio de facturas pendientes",
  "nodes": [
    {
      "name": "Cada día a las 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "oi-0086",
      "position": [
        260,
        220
      ]
    },
    {
      "name": "Facturas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "ID_DE_TU_HOJA",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets (gratis)"
        }
      },
      "id": "oi-0087",
      "position": [
        500,
        220
      ]
    },
    {
      "name": "Calcular vencidas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const hoy = new Date();\nreturn items.map(i => {\n  const dias = Math.floor((hoy - new Date(i.json.vence)) / 86400000);\n  let tramo = 0;\n  if (dias === 3) tramo = 1;\n  else if (dias === 10) tramo = 2;\n  else if (dias >= 20) tramo = 3;\n  return { json: { ...i.json, dias, tramo } };\n}).filter(i => i.json.tramo > 0 && !i.json.cobrada);"
      },
      "id": "oi-0088",
      "position": [
        740,
        220
      ]
    },
    {
      "name": "Según el tramo",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "oi-0012",
                    "leftValue": "={{ $json.tramo }}",
                    "rightValue": 1,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "suave"
            },
            {
              "conditions": {
                "options": {
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "oi-0013",
                    "leftValue": "={{ $json.tramo }}",
                    "rightValue": 2,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "firme"
            },
            {
              "conditions": {
                "options": {
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "oi-0014",
                    "leftValue": "={{ $json.tramo }}",
                    "rightValue": 3,
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "final"
            }
          ]
        },
        "options": {}
      },
      "id": "oi-0089",
      "position": [
        980,
        220
      ]
    },
    {
      "name": "Aviso suave",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "parameters": {
        "fromEmail": "hola@oistudio.eus",
        "toEmail": "={{ $json.email }}",
        "subject": "=Factura {{ $json.numero }} · ¿la habrás pasado por alto?",
        "emailFormat": "html",
        "html": "=<p>Hola {{ $json.cliente }}:</p><p>Te escribimos por la factura <strong>{{ $json.numero }}</strong> de {{ $json.importe }} €, que venció hace unos días. Seguramente sea un despiste.</p><p>Si ya la pagaste, ignorá este correo.</p>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "",
          "name": "Gmail SMTP (gratis)"
        }
      },
      "id": "oi-0090",
      "position": [
        1220,
        220
      ]
    },
    {
      "name": "Aviso firme",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
