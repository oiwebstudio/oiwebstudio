        "fromEmail": "hola@oistudio.eus",
        "toEmail": "={{ $json.email }}",
        "subject": "=Factura {{ $json.numero }} pendiente ({{ $json.dias }} días)",
        "emailFormat": "html",
        "html": "=<p>Hola {{ $json.cliente }}:</p><p>La factura <strong>{{ $json.numero }}</strong> de {{ $json.importe }} € sigue pendiente, ya con {{ $json.dias }} días de retraso.</p><p>¿Nos confirmás una fecha de pago?</p>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "",
          "name": "Gmail SMTP (gratis)"
        }
      },
      "id": "oi-0091",
      "position": [
        260,
