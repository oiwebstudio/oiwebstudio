// EN OBRAS: errotatxo.com sirve ./errotatxo-obras (una sola página para cualquier ruta).
// Para volver a la web completa: directory "./publicado" y not_found_handling "404-page".
// Publicación de errotatxo.com (Cloudflare Workers con archivos estáticos).
//   npx wrangler deploy -c clientes/errotatxo/web.wrangler.jsonc
{
  "name": "errotatxo",
  "main": "./worker.js",
  "routes": [
    { "pattern": "errotatxo.com", "custom_domain": true },
    { "pattern": "www.errotatxo.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./obras",
    "binding": "ASSETS",
    // Pasa antes por el worker para poder redirigir www.
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
