{
  "name": "OI · Reserva con confirmación por WhatsApp",
  "nodes": [
    {
      "name": "Widget de reservas",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "reserva-wa",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "oi-wa-001",
      "id": "oi-wa-001",
      "position": [260, 220]
    },
    {
      "name": "Preparar franja",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst inicio = new Date(b.fecha + 'T' + b.hora + ':00');\nconst fin = new Date(inicio.getTime() + (b.duracion ?? 60) * 60000);\n// Normalizar teléfono: quitar espacios, asegurar prefijo\nlet tel = (b.telefono ?? '').replace(/[^\\d+]/g, '');\nif (tel.startsWith('6') || tel.startsWith('7')) tel = '+34' + tel;\nif (!tel.startsWith('+')) tel = '+34' + tel;\nreturn [{ json: { ...b, telefono: tel, inicio: inicio.toISOString(), fin: fin.toISOString() } }];"
      },
      "id": "oi-wa-002",
      "position": [500, 220]
    },
    {
      "name": "Ver si hay hueco",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "parameters": {
        "operation": "getAll",
        "calendar": { "__rl": true, "value": "primary", "mode": "list" },
        "options": {},
        "returnAll": true,
        "timeMin": "={{ $json.inicio }}",
        "timeMax": "={{ $json.fin }}"
      },
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "", "name": "Google Calendar (gratis)" }
      },
      "id": "oi-wa-003",
      "position": [740, 220]
    },
    {
      "name": "¿Está libre?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const eventos = items.filter(i => i.json.id);\nconst datos = $('Preparar franja').first().json;\nreturn [{ json: { ...datos, libre: eventos.length === 0, ocupados: eventos.length } }];"
      },
      "id": "oi-wa-004",
      "position": [980, 220]
    },
    {
      "name": "¿Franja libre?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "oi-wa-005",
              "leftValue": "={{ $json.libre }}",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "oi-wa-005",
      "position": [1220, 220]
    },
    {
      "name": "Crear la cita",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "parameters": {
        "operation": "create",
        "calendar": { "__rl": true, "value": "primary", "mode": "list" },
        "options": {},
        "start": "={{ $json.inicio }}",
        "end": "={{ $json.fin }}",
        "additionalFields": {
          "summary": "={{ $json.servicio }} · {{ $json.nombre }}",
          "description": "={{ $json.telefono }} · {{ $json.email }}\\nReserva por WhatsApp\\n{{ $json.nota }}"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "", "name": "Google Calendar (gratis)" }
      },
      "id": "oi-wa-006",
      "position": [260, 460]
    },
    {
      "name": "Confirmar por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_PHONE_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.telefono.replace('+','') }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"confirmacion_reserva\",\n    \"language\": { \"code\": \"es\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": \"{{ $json.nombre }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.servicio }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.fecha }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.hora }}\" }\n        ]\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "WhatsApp Cloud API" }
      },
      "id": "oi-wa-007",
      "position": [500, 460]
    },
    {
      "name": "Avisar al negocio por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_PHONE_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.WA_NEGOCIO_TEL }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"📅 Nueva reserva:\\n{{ $json.nombre }}\\n{{ $json.servicio }}\\n{{ $json.fecha }} a las {{ $json.hora }}\\n📞 {{ $json.telefono }}\"\n  }\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "WhatsApp Cloud API" }
      },
      "id": "oi-wa-008",
      "position": [740, 460]
    },
    {
      "name": "Registrar la reserva",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "ID_DE_TU_HOJA", "mode": "id" },
        "sheetName": { "__rl": true, "value": "gid=0", "mode": "list" },
        "options": {},
        "columns": { "mappingMode": "autoMapInputData", "value": {} }
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "", "name": "Google Sheets (gratis)" }
      },
      "id": "oi-wa-009",
      "position": [980, 460]
    },
    {
      "name": "Buscar alternativas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const d = $json, base = new Date(d.inicio), dur = (d.duracion ?? 60);\nconst alt = [1, 2].map(k => new Date(base.getTime() + k * dur * 60000)\n  .toISOString().slice(11, 16));\nreturn [{ json: { ok: false, motivo: 'ocupado', alternativas: alt, telefono: d.telefono, nombre: d.nombre } }];"
      },
      "id": "oi-wa-010",
      "position": [260, 680]
    },
    {
      "name": "Alternativas por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_PHONE_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.telefono.replace('+','') }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"Hola {{ $json.nombre }}, esa hora está ocupada. Te proponemos:\\n\\n⏰ {{ $json.alternativas[0] }}\\n⏰ {{ $json.alternativas[1] }}\\n\\nContesta con la hora que prefieras.\"\n  }\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "WhatsApp Cloud API" }
      },
      "id": "oi-wa-011",
      "position": [500, 680]
    },
    {
      "name": "Responder al widget",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, canal: 'whatsapp' }) }}",
        "options": {}
      },
      "id": "oi-wa-012",
      "position": [1220, 460]
    },
    {
      "name": "Responder ocupado al widget",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "oi-wa-013",
      "position": [740, 680]
    },
    {
      "id": "oi-wa-014",
      "name": "Ficha",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-140, 180],
      "parameters": {
        "width": 380,
        "height": 380,
        "color": 2,
        "content": "## 📱 Reserva con confirmación por WhatsApp\n**auto-reserva-whatsapp**\n\nIgual que auto-reserva-cita pero confirma y avisa por WhatsApp en vez de email.\n\n**Disparador:** Webhook (el widget de reservas de la web)\n\n**Coste:** ~0,03 € por mensaje de plantilla (confirmación)\nMensajes dentro de la conversación abierta: gratis\n1.000 conversaciones de servicio/mes: gratis\n\n**Requisitos:**\n- Meta Business verificado\n- Número de WhatsApp Business (no el personal)\n- Plantilla \"confirmacion_reserva\" aprobada por Meta\n- Variable de entorno: WA_PHONE_ID, WA_NEGOCIO_TEL"
      }
    }
  ],
  "connections": {
    "Widget de reservas": { "main": [[{ "node": "Preparar franja", "type": "main", "index": 0 }]] },
    "Preparar franja": { "main": [[{ "node": "Ver si hay hueco", "type": "main", "index": 0 }]] },
    "Ver si hay hueco": { "main": [[{ "node": "¿Está libre?", "type": "main", "index": 0 }]] },
    "¿Está libre?": { "main": [[{ "node": "¿Franja libre?", "type": "main", "index": 0 }]] },
    "¿Franja libre?": {
      "main": [
        [{ "node": "Crear la cita", "type": "main", "index": 0 }],
        [{ "node": "Buscar alternativas", "type": "main", "index": 0 }]
      ]
    },
    "Crear la cita": { "main": [[{ "node": "Confirmar por WhatsApp", "type": "main", "index": 0 }]] },
    "Confirmar por WhatsApp": { "main": [[{ "node": "Avisar al negocio por WhatsApp", "type": "main", "index": 0 }]] },
    "Avisar al negocio por WhatsApp": { "main": [[{ "node": "Registrar la reserva", "type": "main", "index": 0 }]] },
    "Registrar la reserva": { "main": [[{ "node": "Responder al widget", "type": "main", "index": 0 }]] },
    "Buscar alternativas": { "main": [[{ "node": "Alternativas por WhatsApp", "type": "main", "index": 0 }]] },
    "Alternativas por WhatsApp": { "main": [[{ "node": "Responder ocupado al widget", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveManualExecutions": true },
  "tags": [{ "name": "OI Studio" }, { "name": "whatsapp" }],
  "meta": { "instanceId": "oi-studio-biblioteca" }
}